{
  "name": "gas-app-score-portal",
  "version": "0.1.0",
  "private": true,
  "description": "Score Portal: a Google Apps Script web app that syncs Google Forms scores to a spreadsheet and serves them to respondents.",
  "repository": {
    "type": "git",
    "url": "https://github.com/yorsh-co/gas-app-score-portal.git"
  },
  "license": "MIT",
  "engines": {
    "node": "^22.15.0 || ^24.0.0 || >=26.0.0"
  },
  "type": "module",
  "prettier": "gasdev/prettier",
  "devDependencies": {
    "@google/clasp": "^3.4.1",
    "@types/google-apps-script": "^2.0.13",
    "@types/node": "^22.20.5",
    "eslint": "^10.7.0",
    "gasdev": "github:yorsh-co/gasdev#semver:^3.0.0-beta.2",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "minimatch": "^11.0.1",
    "gaxios": "^7.3.1"
  },
  "gasdev": {
    "loadOrder": [
      "core/logger.ts",
      "shared/i18n/en.ts",
      "shared/i18n/pt-BR.ts",
      "shared/i18n/i18n.ts",
      "core/config.ts",
      "core/errors.ts",
      "utils/types/stringUtils.ts",
      "utils/drive/DriveUtils.ts",
      "utils/form/FormUtils.ts",
      "utils/spreadsheet/toastUtil.ts",
      "utils/spreadsheet/uiUtils.ts",
      "utils/apps_script/executionTimer.ts",
      "utils/apps_script/triggerUtils.ts",
      "infra/db/db.ts",
      "infra/db/forms.repo.ts",
      "infra/db/respondents.repo.ts",
      "infra/db/scores.repo.ts",
      "infra/db/overview.ts",
      "infra/db/migrate-legacy.ts",
      "domain/LinkedForm.ts",
      "infra/drive/GDrive.ts",
      "infra/forms/GForms.ts",
      "infra/forms/Cursor.ts",
      "app/FormsImporter.ts",
      "app/RespondentScoreSynchronizer.ts",
      "triggers/install.ts",
      "triggers/handlers/syncScores.ts",
      "ui/menu/display.ts",
      "ui/menu/handlers/forms.ts",
      "ui/menu/handlers/install.ts",
      "generated/portal.html.ts",
      "auth/otp.service.ts",
      "auth/session.service.ts",
      "auth/mailer.ts",
      "auth/auth.middleware.ts",
      "webapp/scores.service.ts",
      "webapp/routes.ts",
      "webapp/app.ts",
      "webapp/main.ts"
    ],
    "html": [
      {
        "entry": "src/web/portal.html",
        "out": "src/generated/portal.html.ts",
        "name": "_PORTAL_HTML"
      }
    ],
    "bundle": {
      "libraries": {
        "gas-webapp": "^1.0.4",
        "gas-sheetdb": "^2.1.5",
        "gas-config": "^2.0.4",
        "gas-error": "^1.2.5",
        "gas-logger": "^2.0.4",
        "gas-lock": "^1.2.4"
      },
      "outFile": "src/lib/gas-libraries.js",
      "typesFile": "types/gas-libraries.d.ts"
    },
    "peers": {
      "gas-webapp": "^1.0.4",
      "gas-sheetdb": "^2.1.5",
      "gas-config": "^2.0.4",
      "gas-error": "^1.2.5",
      "gas-logger": "^2.0.4",
      "gas-lock": "^1.2.4"
    },
    "ci": {
      "title": "gas-app-score-portal"
    },
    "gasTest": {
      "scopes": [
        "https://www.googleapis.com/auth/spreadsheets",
        "https://www.googleapis.com/auth/script.storage",
        "https://www.googleapis.com/auth/forms"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.js",
    "build:watch": "node scripts/build.js --watch",
    "build:frontend": "tsc -p tsconfig.frontend.json --noEmit && gasdev html",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p gas-test/tsconfig.json --noEmit",
    "bundle:libs": "gasdev bundle",
    "deploy:setup": "gasdev setup",
    "clasp:push": "npm run build && clasp push --force",
    "clean": "rimraf dist",
    "release": "gasdev release",
    "build:format": "npm run check && npm run build && npm run format:dist",
    "build:release": "npm run build:format && npm run release",
    "lint": "eslint . && echo '✓ Lint passed'",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:dist": "prettier ./dist --write --ignore-path .prettierignore",
    "format:check": "prettier . --check",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && gasdev check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:gas:build": "gasdev gas-test build",
    "test:gas": "gasdev gas-test run"
  }
}
