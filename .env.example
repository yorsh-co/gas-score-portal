# Dedicated standalone Apps Script project for `npm run test:gas`.
# A run replaces the whole project, so never point this at the dev script.
GAS_TEST_SCRIPT_ID=

# Spreadsheet the tests create their `__gt_<epochMs>_` sheets in.
# Optional when the GAS_TEST_SPREADSHEET_ID script property is set.
GAS_TEST_SPREADSHEET_ID=
