{
  "extends": "gas-dev-config/tsconfig/gas.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "allowJs": true,
    "checkJs": false,
    "declaration": false
  },
  "include": ["src/**/*.ts", "src/**/*.js", "types/**/*.d.ts"],
  "exclude": ["src/web/**/*", "src/lib/**"]
}
